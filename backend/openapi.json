{
    "openapi": "3.0.0",
    "info": {
        "title": "FitTrack API",
        "description": "REST API documentation for the FitTrack fitness tracking application.",
        "version": "1.0.0"
    },
    "servers": [
        {
            "url": "http://localhost:8000",
            "description": "Local development server"
        }
    ],
    "paths": {
        "/exercises": {
            "get": {
                "tags": [
                    "Exercises"
                ],
                "summary": "Get all exercises",
                "operationId": "8339067e488de809f255c7ce499981d1",
                "responses": {
                    "200": {
                        "description": "List of all exercises",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "array",
                                    "items": {
                                        "properties": {
                                            "exercise_id": {
                                                "type": "integer",
                                                "example": 1
                                            },
                                            "name": {
                                                "type": "string",
                                                "example": "Squats"
                                            },
                                            "muscle_group": {
                                                "type": "string",
                                                "example": "legs"
                                            },
                                            "difficulty": {
                                                "type": "string",
                                                "example": "beginner"
                                            }
                                        },
                                        "type": "object"
                                    }
                                }
                            }
                        }
                    },
                    "500": {
                        "description": "Internal server error"
                    }
                }
            },
            "post": {
                "tags": [
                    "Exercises"
                ],
                "summary": "Create a new exercise",
                "operationId": "8f4c028eb71355ce22343ea7e716fcd7",
                "requestBody": {
                    "description": "Exercise data",
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "name",
                                    "muscle_group",
                                    "difficulty"
                                ],
                                "properties": {
                                    "name": {
                                        "type": "string",
                                        "example": "Squats"
                                    },
                                    "muscle_group": {
                                        "type": "string",
                                        "example": "legs"
                                    },
                                    "difficulty": {
                                        "type": "string",
                                        "enum": [
                                            "beginner",
                                            "intermediate",
                                            "advanced"
                                        ],
                                        "example": "beginner"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Exercise created successfully",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "message": {
                                            "type": "string",
                                            "example": "Exercise created successfully"
                                        },
                                        "exercise_id": {
                                            "type": "integer",
                                            "example": 12
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "400": {
                        "description": "Invalid exercise data"
                    },
                    "500": {
                        "description": "Internal server error"
                    }
                }
            }
        },
        "/exercises/muscle/{muscle_group}": {
            "get": {
                "tags": [
                    "Exercises"
                ],
                "summary": "Get exercises by muscle group",
                "operationId": "59b7be18959792d1dd8437ca19ceedd5",
                "parameters": [
                    {
                        "name": "muscle_group",
                        "in": "path",
                        "description": "Muscle group",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "example": "legs"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Exercises retrieved successfully",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "array",
                                    "items": {
                                        "type": "object"
                                    }
                                }
                            }
                        }
                    },
                    "400": {
                        "description": "Invalid muscle group"
                    },
                    "500": {
                        "description": "Internal server error"
                    }
                }
            }
        },
        "/exercises/{id}": {
            "get": {
                "tags": [
                    "Exercises"
                ],
                "summary": "Get exercise by ID",
                "operationId": "94914ee16252f4a07118ea5f0bd4bb3f",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "description": "Exercise ID",
                        "required": true,
                        "schema": {
                            "type": "integer",
                            "minimum": 1,
                            "example": 1
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Exercise found",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "exercise_id": {
                                            "type": "integer",
                                            "example": 1
                                        },
                                        "name": {
                                            "type": "string",
                                            "example": "Squats"
                                        },
                                        "muscle_group": {
                                            "type": "string",
                                            "example": "legs"
                                        },
                                        "difficulty": {
                                            "type": "string",
                                            "example": "beginner"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "404": {
                        "description": "Exercise not found"
                    },
                    "500": {
                        "description": "Internal server error"
                    }
                }
            },
            "put": {
                "tags": [
                    "Exercises"
                ],
                "summary": "Update an existing exercise",
                "operationId": "1f923a65c6de8652406be0f646a464a3",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "description": "Exercise ID",
                        "required": true,
                        "schema": {
                            "type": "integer",
                            "minimum": 1,
                            "example": 1
                        }
                    }
                ],
                "requestBody": {
                    "description": "Fields to update",
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "properties": {
                                    "name": {
                                        "type": "string",
                                        "example": "Updated Squats"
                                    },
                                    "muscle_group": {
                                        "type": "string",
                                        "example": "legs"
                                    },
                                    "difficulty": {
                                        "type": "string",
                                        "enum": [
                                            "beginner",
                                            "intermediate",
                                            "advanced"
                                        ],
                                        "example": "intermediate"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Exercise updated successfully"
                    },
                    "400": {
                        "description": "Invalid exercise data"
                    },
                    "404": {
                        "description": "Exercise not found"
                    },
                    "500": {
                        "description": "Internal server error"
                    }
                }
            },
            "delete": {
                "tags": [
                    "Exercises"
                ],
                "summary": "Delete an exercise",
                "operationId": "42e98ba87e4d76334ae86057046d7148",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "description": "Exercise ID",
                        "required": true,
                        "schema": {
                            "type": "integer",
                            "minimum": 1,
                            "example": 1
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Exercise deleted successfully",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "message": {
                                            "type": "string",
                                            "example": "Exercise deleted successfully"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "404": {
                        "description": "Exercise not found"
                    },
                    "500": {
                        "description": "Internal server error"
                    }
                }
            }
        }
    },
    "tags": [
        {
            "name": "Exercises",
            "description": "Exercises"
        }
    ]
}